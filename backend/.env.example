# VocabTrainer Backend Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit .env to version control. .env is gitignored.

# Node environment (development | production)
NODE_ENV=development

# Port the backend listens on
PORT=4000

# --- MongoDB ---
# Connection string for MongoDB Atlas or local MongoDB.
# Example: mongodb+srv://<user>:<pass>@cluster.mongodb.net/?appName=VocabTrainer
# For local: mongodb://127.0.0.1:27017/vocabtrainer
MONGO_URI=mongodb://127.0.0.1:27017/vocabtrainer

# --- JWT ---
# Long, random secrets used to sign access and refresh tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# Token lifetimes (ms or string like "15m", "7d")
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_COOKIE_NAME=refreshToken

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=12

# --- Google OAuth ---
# Client ID from Google Cloud Console (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Frontend URLs ---
# Local Vite dev server
CLIENT_URL=http://localhost:5173
# Production frontend (Render)
PROD_CLIENT_URL=https://your-app.onrender.com

# --- Brevo (transactional email) ---
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=notifications@example.com
BREVO_SENDER_NAME=VocabTrainer

# --- OpenAI ---
OPENAI_API_KEY=sk-your_openai_api_key

# --- AI usage limits ---
# Comma-separated emails exempt from the daily AI call limit (e.g. admin)
UNLIMITED_EMAILS=harshalkatkar76@gmail.com

# --- Super Admin (Stage 2) ---
# Initial Super Admin email — provisioned securely by the backend only.
SUPER_ADMIN_EMAIL=harshalkatkar76@gmail.com

# --- Razorpay (Stage 4) ---
# Razorpay test mode credentials for development.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Resend (Stage 5) ---
# Resend API key for sending administrative alerts
RESEND_API_KEY=re_your_resend_api_key
# Sender email address (must be verified in Resend)
RESEND_SENDER_EMAIL=alerts@example.com
# Sender display name
RESEND_SENDER_NAME=VocabTrainer Alerts
# Email address to receive all security/admin alerts
ALERT_EMAIL=harshalkatkar76@gmail.com
